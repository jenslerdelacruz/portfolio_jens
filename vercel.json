{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "nodeVersion": "20.x",
  "framework": null,
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/dist/client/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
